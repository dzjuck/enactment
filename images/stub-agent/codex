#!/bin/sh
# Stands in for the provider CLI so parsing, redaction, timeout and failure handling are
# testable without spending tokens. Arguments are ignored, which is the point: the harness's
# argv must work unchanged.
#
# Writing is deliberately independent of the outcome. A real agent dirties the workspace and
# *then* fails, so restoration has something to undo; a stub that only wrote on the success
# path would make every restoration test vacuous.
set -e

case "${HARNESS_PHASE:-agent}" in
  tests)
    STUB_MODE="${STUB_MODE_TESTS-${STUB_MODE-events}}"
    STUB_EVENTS="${STUB_EVENTS_TESTS-${STUB_EVENTS-}}"
    STUB_WRITE_PATH="${STUB_WRITE_PATH_TESTS-${STUB_WRITE_PATH-}}"
    STUB_WRITE_CONTENT="${STUB_WRITE_CONTENT_TESTS-${STUB_WRITE_CONTENT-}}"
    STUB_SYMLINK_PATH="${STUB_SYMLINK_PATH_TESTS-${STUB_SYMLINK_PATH-}}"
    STUB_SYMLINK_TARGET="${STUB_SYMLINK_TARGET_TESTS-${STUB_SYMLINK_TARGET-}}"
    ;;
  implementation)
    STUB_MODE="${STUB_MODE_IMPLEMENTATION-${STUB_MODE-events}}"
    STUB_EVENTS="${STUB_EVENTS_IMPLEMENTATION-${STUB_EVENTS-}}"
    STUB_WRITE_PATH="${STUB_WRITE_PATH_IMPLEMENTATION-${STUB_WRITE_PATH-}}"
    STUB_WRITE_CONTENT="${STUB_WRITE_CONTENT_IMPLEMENTATION-${STUB_WRITE_CONTENT-}}"
    STUB_SYMLINK_PATH="${STUB_SYMLINK_PATH_IMPLEMENTATION-${STUB_SYMLINK_PATH-}}"
    STUB_SYMLINK_TARGET="${STUB_SYMLINK_TARGET_IMPLEMENTATION-${STUB_SYMLINK_TARGET-}}"
    ;;
esac

if [ -n "$STUB_WRITE_PATH" ]; then
  mkdir -p "$(dirname "/workspace/${STUB_WRITE_PATH}")"
  printf '%s' "$STUB_WRITE_CONTENT" > "/workspace/${STUB_WRITE_PATH}"
fi

# Report what the read-only documentation mount contains, so the test can assert on a real
# container's view of /context rather than on the harness's intent.
if [ -n "${STUB_CONTEXT_REPORT_PATH:-}" ]; then
  target="/workspace/${STUB_CONTEXT_REPORT_PATH}"
  mkdir -p "$(dirname "$target")"
  {
    if [ -d /context ]; then echo "context: present"; else echo "context: absent"; fi
    [ -f /context/index.md ] && cat /context/index.md
    if [ -n "${STUB_CONTEXT_FILE:-}" ] && [ -f "/context/files/${STUB_CONTEXT_FILE}" ]; then
      cat "/context/files/${STUB_CONTEXT_FILE}"
      echo
    fi
    if echo tampered > /context/tampered.md 2>/dev/null; then
      echo "write: allowed"
    else
      echo "write: refused"
    fi
  } > "$target"
fi

if [ -n "$STUB_SYMLINK_PATH" ]; then
  mkdir -p "$(dirname "/workspace/${STUB_SYMLINK_PATH}")"
  ln -sf "${STUB_SYMLINK_TARGET}" "/workspace/${STUB_SYMLINK_PATH}"
fi

# Appending, unlike writing, makes the result depend on what the workspace already held. It is
# how a multi-step test proves a later step was seeded from the earlier step's accepted commit
# rather than from the base: the same fixed environment produces a different file each time.
if [ -n "${STUB_APPEND_PATH:-}" ]; then
  mkdir -p "$(dirname "/workspace/${STUB_APPEND_PATH}")"
  printf '%s' "${STUB_APPEND_CONTENT:-}" >> "/workspace/${STUB_APPEND_PATH}"
fi

# Rotate the credential the way the provider CLI does: rewrite auth.json in place, before
# whatever outcome follows. A token rotated by a run that then failed must still be kept.
if [ -n "$STUB_AUTH_CONTENT" ]; then
  printf '%s' "$STUB_AUTH_CONTENT" > "${CODEX_HOME:-/run/agent-auth}/auth.json"
fi

# The ways a wedged provider CLI can leave a credential the harness cannot use. Copy-back has
# to fail on each of them rather than quietly keep the old token and claim a clean run.
case "${STUB_AUTH_FATE:-}" in
  remove) rm -f "${CODEX_HOME:-/run/agent-auth}/auth.json" ;;
  unreadable) chmod 0 "${CODEX_HOME:-/run/agent-auth}/auth.json" ;;
esac

case "${STUB_MODE:-events}" in
  events|malformed|write)
    printf '%s\n' "$STUB_EVENTS"
    ;;
  fail)
    printf 'stub agent failed\n' >&2
    exit 4
    ;;
  hang)
    trap '' TERM
    while true; do sleep 1; done
    ;;
  *)
    printf 'unknown STUB_MODE: %s\n' "$STUB_MODE" >&2
    exit 64
    ;;
esac
