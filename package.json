{
  "name": "enactment",
  "bin": { "enactment": "dist/cli.js" },
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "Ilya Lavrov",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run --project hermetic",
    "test:docker": "ENACTMENT_IMAGES=1 vitest run --project docker-images --no-file-parallelism && vitest run --project docker && ENACTMENT_GLOBAL=1 vitest run --project docker-global --no-file-parallelism",
    "test:live": "ENACTMENT_LIVE=1 vitest run --project live --no-file-parallelism",
    "build": "tsc --project tsconfig.build.json && echo '{\"type\":\"module\"}' > dist/package.json",
    "demo:replay": "node demo/run.mjs replay",
    "demo": "node demo/run.mjs live",
    "images:build": "npm run build && node dist/images-build.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:all": "npm test && npm run test:docker"
  },
  "dependencies": {
    "execa": "^9.6.0",
    "picomatch": "^4.0.3",
    "tar-stream": "^3.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.2",
    "@types/tar-stream": "^3.1.4",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
