{
  "name": "ai-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --project hermetic",
    "test:docker": "vitest run --project docker --no-file-parallelism",
    "test:live": "vitest run --project live",
    "build": "tsc --project tsconfig.build.json && echo '{\"type\":\"module\"}' > dist/package.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "execa": "^9.6.0",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/picomatch": "^4.0.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
