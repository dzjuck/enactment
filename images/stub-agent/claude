#!/bin/sh
set -eu

[ -z "${STUB_CLAUDE_STDERR:-}" ] || printf '%s\n' "$STUB_CLAUDE_STDERR" >&2

case "${STUB_CLAUDE_MODE:-events}" in
  events)
    printf '%s\n' "$STUB_CLAUDE_EVENTS"
    ;;
  provider-error)
    printf '%s\n' '{"type":"system","subtype":"init","model":"claude-sonnet-5"}'
    printf '%s\n' '{"type":"result","subtype":"error_during_execution","is_error":true,"terminal_reason":"api_error","api_error_status":429,"result":"provider refused","duration_ms":1,"usage":{}}'
    exit 1
    ;;
  diagnosis)
    printf '%s\n' '{"type":"system","subtype":"init","model":"claude-opus-5","tools":[]}'
    printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"result":"Diagnosis complete.","duration_ms":10,"usage":{"input_tokens":5,"output_tokens":2,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}'
    ;;
  hang)
    trap '' TERM
    while true; do sleep 1; done
    ;;
  *)
    printf 'unknown STUB_CLAUDE_MODE: %s\n' "$STUB_CLAUDE_MODE" >&2
    exit 64
    ;;
esac
